FROM dhi.io/nginx:1-alpine

# Build context is the repo root (backend/docker-compose.yml): the configs live
# under backend/nginx/ and the assets it serves live under frontend/static/.
COPY backend/nginx/default.conf                     /etc/nginx/conf.d/default.conf
COPY backend/nginx/certs/selfsigned.crt             /etc/nginx/certs/selfsigned.crt
COPY --chmod=644 backend/nginx/certs/selfsigned.key /etc/nginx/certs/selfsigned.key
COPY frontend/static/                               /frontend/static/
